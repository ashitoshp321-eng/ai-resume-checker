# Database configuration
# For local development without Docker, use SQLite (default):
# DATABASE_URL=sqlite+aiosqlite:///./resume_db.sqlite
# For PostgreSQL via Docker Compose:
DATABASE_URL=postgresql+asyncpg://admin:password123@localhost:5432/resume_db

# Security
SECRET_KEY=change-me-to-a-secure-random-string

# File upload constraints
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_BATCH=20
UPLOAD_DIR=./uploads

# AI Models & LLM (Chatbot)
# Option 1: Use OpenAI for the HR Assistant
OPENAI_API_KEY=

# Option 2: Use Ollama (local open-source LLMs)
OLLAMA_BASE_URL=

# Note: If neither OpenAI nor Ollama are configured, the chatbot will use a fallback template mode.
